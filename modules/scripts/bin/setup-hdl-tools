#!/usr/bin/env bash
# setup-hdl-tools: HDL の回路図表示・波形表示に使うツールをインストールする
#
# 対応: macOS (Homebrew) / Ubuntu (apt)
#
# 入るもの:
#   yosys       論理合成ツール (HDL -> ゲートの接続 (ネットリスト))
#   graphviz    yosys の `show` で回路図を描くのに使う (dot コマンド)
#   sv2v        SystemVerilog -> Verilog 変換 (yosys が読める形にする)
#   netlistsvg  yosys の出力から見やすい回路図 SVG を描く (npm)
#   surfer      波形ビューア (VCD / FST)
#   verilator   シミュレータ
#
# バージョンは環境変数で上書きできる (Linux でバイナリを落とすもの / npm のみ):
#   SV2V_VERSION, SURFER_VERSION, NETLISTSVG_VERSION
set -euo pipefail

SV2V_VERSION="${SV2V_VERSION:-0.0.13}"
SURFER_VERSION="${SURFER_VERSION:-0.7.0}"
NETLISTSVG_VERSION="${NETLISTSVG_VERSION:-1.0.2}"
LOCAL_BIN="${LOCAL_BIN:-${HOME}/.local/bin}"

WITH_VIEWER=1
DRY_RUN=0

usage() {
    cat <<USAGE
Usage: $(basename "$0") [options]

HDL の回路図・波形表示ツール (yosys, graphviz, sv2v, verilator, netlistsvg, surfer) を入れる。
すでに入っているものはスキップする。

Options:
  --no-viewer   波形ビューア (surfer) を入れない (GUI の無いサーバ向け)
  --dry-run     実行するコマンドを表示するだけで、何もしない
  -h, --help    このヘルプを表示
USAGE
}

while (($# > 0)); do
    case "$1" in
        --no-viewer) WITH_VIEWER=0 ;;
        --dry-run) DRY_RUN=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            echo "Error: unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mWarning:\033[0m %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

run() {
    if ((DRY_RUN)); then
        printf '+ %s\n' "$*"
    else
        "$@"
    fi
}

TMP_DIR=""
cleanup() {
    if [[ -n "${TMP_DIR}" ]]; then
        rm -rf "${TMP_DIR}"
    fi
}
trap cleanup EXIT

# zip を落として、中の 1 ファイルを LOCAL_BIN に置く
#   install_bin_from_zip <url> <zip 内のパス> <コマンド名>
install_bin_from_zip() {
    local url="$1" member="$2" name="$3"
    if ((DRY_RUN)); then
        printf '+ curl %s && unzip %s -> %s/%s\n' "${url}" "${member}" "${LOCAL_BIN}" "${name}"
        return 0
    fi
    [[ -z "${TMP_DIR}" ]] && TMP_DIR="$(mktemp -d)"
    local zip="${TMP_DIR}/${name}.zip"
    curl -fsSL -o "${zip}" "${url}"
    unzip -o -q "${zip}" "${member}" -d "${TMP_DIR}/${name}"
    install -d -m 0755 "${LOCAL_BIN}"
    install -m 0755 "${TMP_DIR}/${name}/${member}" "${LOCAL_BIN}/${name}"
}

install_netlistsvg() {
    if have netlistsvg; then
        log "netlistsvg: already installed"
        return 0
    fi
    if have npm; then
        log "netlistsvg: npm install -g netlistsvg@${NETLISTSVG_VERSION}"
        run npm install -g "netlistsvg@${NETLISTSVG_VERSION}"
        if have mise; then
            run mise reshim
        fi
    elif have brew; then
        log "netlistsvg: npm not found, using Homebrew"
        run brew install netlistsvg
    else
        warn "netlistsvg: npm が見つからないのでスキップ (Node.js を入れてから再実行してください)"
    fi
}

#=============================
# macOS
#=============================
setup_macos() {
    if ! have brew; then
        echo "Error: Homebrew が見つかりません (https://brew.sh)" >&2
        exit 1
    fi

    local pkgs=(yosys graphviz sv2v verilator)
    ((WITH_VIEWER)) && pkgs+=(surfer)

    local missing=()
    local p
    for p in "${pkgs[@]}"; do
        if brew list --formula "${p}" >/dev/null 2>&1; then
            log "${p}: already installed"
        else
            missing+=("${p}")
        fi
    done
    if ((${#missing[@]} > 0)); then
        log "brew install ${missing[*]}"
        run brew install "${missing[@]}"
    fi

    install_netlistsvg
}

#=============================
# Ubuntu
#=============================
setup_ubuntu() {
    if ! have apt-get; then
        echo "Error: apt-get が見つかりません (Ubuntu/Debian のみ対応)" >&2
        exit 1
    fi

    local sudo=()
    ((EUID != 0)) && sudo=(sudo)

    log "apt-get install yosys graphviz verilator curl unzip"
    run "${sudo[@]}" apt-get update
    run "${sudo[@]}" apt-get install -y yosys graphviz verilator curl unzip

    # sv2v / surfer は Linux では x86_64 用のビルド済みバイナリのみ配布されている
    local arch
    arch="$(uname -m)"

    if have sv2v; then
        log "sv2v: already installed"
    elif [[ "${arch}" == "x86_64" ]]; then
        log "sv2v ${SV2V_VERSION} -> ${LOCAL_BIN}"
        install_bin_from_zip \
            "https://github.com/zachjs/sv2v/releases/download/v${SV2V_VERSION}/sv2v-Linux.zip" \
            "sv2v-Linux/sv2v" sv2v
    else
        warn "sv2v: ${arch} 用のバイナリは配布されていません。ソースからビルドしてください (https://github.com/zachjs/sv2v)"
    fi

    if ((WITH_VIEWER)); then
        if have surfer; then
            log "surfer: already installed"
        elif [[ "${arch}" == "x86_64" ]]; then
            log "surfer ${SURFER_VERSION} -> ${LOCAL_BIN}"
            install_bin_from_zip \
                "https://gitlab.com/api/v4/projects/42073614/packages/generic/surfer/v${SURFER_VERSION}/surfer_linux_v${SURFER_VERSION}.zip" \
                "surfer" surfer
        else
            warn "surfer: ${arch} 用のバイナリは配布されていません。cargo install --git https://gitlab.com/surfer-project/surfer surfer で入れられます"
        fi
    fi

    install_netlistsvg

    case ":${PATH}:" in
        *":${LOCAL_BIN}:"*) ;;
        *) warn "${LOCAL_BIN} が PATH に入っていません。シェルの設定に追加してください" ;;
    esac
}

#=============================
# main
#=============================
case "$(uname -s)" in
    Darwin) setup_macos ;;
    Linux) setup_ubuntu ;;
    *)
        echo "Error: unsupported OS: $(uname -s)" >&2
        exit 1
        ;;
esac

((DRY_RUN)) && exit 0

echo
log "インストール結果"
for cmd in yosys dot sv2v verilator netlistsvg surfer; do
    if have "${cmd}"; then
        printf '  %-11s %s\n' "${cmd}" "$(command -v "${cmd}")"
    else
        printf '  %-11s (not found)\n' "${cmd}"
    fi
done
