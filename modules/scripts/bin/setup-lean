#!/usr/bin/env bash
# setup-lean: elan で Lean のツールチェーン管理を入れる
#
# PATH は modules/scripts/rc.d/scripts.sh が設定する。
set -euo pipefail

if [[ -x "${HOME}/.elan/bin/elan" ]]; then
    echo "elan: already installed"
    exit 0
fi

curl -fsSL https://elan.lean-lang.org/elan-init.sh | sh -s -- -y --no-modify-path
