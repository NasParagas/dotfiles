#!/usr/bin/env bash
# setup-rust: rustup で Rust ツールチェーンを入れる
#
# ~/.bashrc はこのリポジトリへのリンクなので、--no-modify-path で書き換えを防ぐ。
# PATH は modules/scripts/shell.sh が設定する。
set -euo pipefail

if [[ -x "${HOME}/.cargo/bin/rustc" ]]; then
    echo "rust: already installed"
    exit 0
fi

curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
